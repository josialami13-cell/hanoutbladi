"use client";

import { useState } from "react";
import { useCartStore } from "@/store/cart";
import { FiArrowLeft, FiPlus, FiCheck } from "react-icons/fi";
import TranslatedText from "@/components/TranslatedText";

export default function CatalogView({ departments }: { departments: any[] }) {
  const [selectedDept, setSelectedDept] = useState<any | null>(null);
  const [selectedCat, setSelectedCat] = useState<any | null>(null);
  const [addedId, setAddedId] = useState<string | null>(null);

  const addItem = useCartStore((state) => state.addItem);

  const handleAddToCart = (product: any) => {
    addItem({
      id: product.id,
      name_fr: product.name_fr,
      name_ar: product.name_ar,
      price: product.price,
      image: product.image || "",
    });
    setAddedId(product.id);
    setTimeout(() => setAddedId(null), 1500);
  };

  // 1. VUE : Départements
  if (!selectedDept) {
    return (
      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {departments.map((dept) => (
          <div
            key={dept.id}
            onClick={() => setSelectedDept(dept)}
            className="bg-white p-6 rounded-xl shadow-md border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer text-center group"
          >
            <div className="w-16 h-16 rounded-full bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center mx-auto mb-4 shadow-inner">
              <span className="text-2xl text-white">🏪</span>
            </div>
            <h3 className="font-bold text-gray-900 group-hover:text-emerald-600 text-lg transition">
              <TranslatedText text={dept.name_fr} arText={dept.name_ar} />
            </h3>
            <span className="inline-block mt-4 text-xs font-semibold text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
              {dept.categories?.length || 0}{" "}
              <TranslatedText text="catégorie(s)" arText="أقسام" />
            </span>
          </div>
        ))}
      </div>
    );
  }

  // 2. VUE : Catégories
  if (!selectedCat) {
    return (
      <div>
        <button
          type="button"
          onClick={() => setSelectedDept(null)}
          className="flex items-center gap-2 text-sm font-semibold text-emerald-600 mb-6 hover:underline cursor-pointer"
        >
          <FiArrowLeft /> <TranslatedText text="Retour aux départements" arText="العودة إلى الأقسام" />
        </button>

        <div className="mb-6 border-b pb-2">
          <h3 className="text-2xl font-bold text-gray-900">
            <TranslatedText text={selectedDept.name_fr} arText={selectedDept.name_ar} />
          </h3>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {selectedDept.categories?.map((cat: any) => (
            <div
              key={cat.id}
              onClick={() => setSelectedCat(cat)}
              className="bg-white p-6 rounded-xl shadow-md border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer text-center group"
            >
              <div className="w-14 h-14 rounded-full bg-emerald-50 flex items-center justify-center mx-auto mb-3">
                <span className="text-2xl text-emerald-600">🌿</span>
              </div>
              <h4 className="font-bold text-gray-900 group-hover:text-emerald-600 transition">
                <TranslatedText text={cat.name_fr} arText={cat.name_ar} />
              </h4>
            </div>
          ))}
        </div>
      </div>
    );
  }

  // 3. VUE : Produits
  return (
    <div>
      <button
        type="button"
        onClick={() => setSelectedCat(null)}
        className="flex items-center gap-2 text-sm font-semibold text-emerald-600 mb-6 hover:underline cursor-pointer"
      >
        <FiArrowLeft /> <TranslatedText text="Retour aux catégories" arText="العودة إلى الفئات" />
      </button>

      <div className="mb-6 border-b pb-2 flex justify-between items-baseline">
        <h3 className="text-2xl font-bold text-gray-900">
          <TranslatedText text={selectedCat.name_fr} arText={selectedCat.name_ar} />
        </h3>
      </div>

      {!selectedCat.products || selectedCat.products.length === 0 ? (
        <p className="text-gray-500 italic">
          <TranslatedText text="Aucun produit disponible pour le moment." arText="لا يوجد أي منتج حاليا." />
        </p>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {selectedCat.products.map((product: any) => (
            <div
              key={product.id}
              className="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden flex flex-col justify-between"
            >
              <div className="h-44 bg-gray-100 flex items-center justify-center overflow-hidden">
                {product.image ? (
                  <img src={product.image} alt={product.name_fr} className="w-full h-full object-cover" />
                ) : (
                  <span className="text-gray-400 text-xs">
                    <TranslatedText text="Pas d'image" arText="بدون صورة" />
                  </span>
                )}
              </div>
              <div className="p-4">
                <h4 className="font-bold text-gray-900">
                  <TranslatedText text={product.name_fr} arText={product.name_ar} />
                </h4>
                {product.description_fr && (
                  <p className="text-gray-500 text-xs line-clamp-2 mt-2">
                    <TranslatedText text={product.description_fr} arText={product.description_ar} />
                  </p>
                )}
              </div>
              <div className="p-4 border-t flex items-center justify-between">
                <span className="text-lg font-bold text-gray-900">{product.price} DH</span>
                <button
                  type="button"
                  onClick={() => handleAddToCart(product)}
                  className={`${
                    addedId === product.id ? "bg-green-600" : "bg-emerald-600 hover:bg-emerald-700"
                  } text-white text-xs font-bold px-3 py-2 rounded-lg flex items-center gap-1 transition-colors cursor-pointer`}
                >
                  {addedId === product.id ? <FiCheck /> : <FiPlus />}
                  {addedId === product.id ? (
                    <TranslatedText text="Ajouté !" arText="تمت الإضافة!" />
                  ) : (
                    <TranslatedText text="Ajouter" arText="إضافة" />
                  )}
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}