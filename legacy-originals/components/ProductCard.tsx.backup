"use client";

import Link from "next/link";
import { FiShoppingCart } from "react-icons/fi";
import { useCartStore } from "@/store/cart";
import TranslatedText from "@/components/TranslatedText";

export interface ProductCardProps {
  product: {
    id: string;
    name_fr: string;
    name_ar?: string | null;
    slug: string;
    price: number | any;
    discount?: number | null;
    totalPrice?: number | null;
    images?: string[];
    image?: string | null;
    promotionalBadge?: string | null;
    cooperative?: string | null;
    originRegion?: string | null;
    isBioCertified?: boolean;
    category?: {
      name_fr: string;
      name_ar?: string | null;
    } | null;
  };
}

export default function ProductCard({ product }: ProductCardProps) {
  const { addItem } = useCartStore();

  const imageUrl =
    product.image ||
    (product.images && product.images.length > 0 ? product.images[0] : "/placeholder.png");

  const rawPrice = Number(product.price || 0);
  const finalPrice =
    product.totalPrice || (product.discount ? rawPrice - product.discount : rawPrice);
  const originalPrice =
    product.discount && product.discount > 0 ? rawPrice : null;

  return (
    <div className="bg-white rounded-2xl shadow-sm hover:shadow-md border border-gray-100 transition-all duration-300 overflow-hidden flex flex-col justify-between">
      <div>
        {/* Zone Image */}
        <Link href={`/product/${product.slug}`}>
          <div className="relative h-56 bg-gray-50 overflow-hidden">
            {imageUrl ? (
              <img
                src={imageUrl}
                alt={product.name_fr}
                className="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              />
            ) : (
              <div className="w-full h-full flex items-center justify-center text-gray-400 text-sm">
                <TranslatedText text="Pas d'image" arText="بدون صورة" />
              </div>
            )}

            {/* Badges */}
            <div className="absolute top-3 left-3 flex flex-col gap-1 items-start">
              {product.promotionalBadge && (
                <span className="bg-emerald-600 text-white text-xs px-2.5 py-1 rounded-full font-medium shadow-sm">
                  <TranslatedText text={product.promotionalBadge} />
                </span>
              )}
              {product.isBioCertified && (
                <span className="bg-green-600 text-white text-xs px-2.5 py-1 rounded-full font-medium shadow-sm">
                  <TranslatedText text="BIO / ONSSA 🌿" arText="عضوي / ONSSA 🌿" />
                </span>
              )}
            </div>
          </div>
        </Link>

        {/* Détails du produit */}
        <div className="p-4">
          {(product.cooperative || product.originRegion) && (
            <div className="flex items-center gap-1 text-xs text-emerald-600 font-semibold mb-1">
              <span>
                <TranslatedText text={product.cooperative || product.originRegion || ""} />
              </span>
            </div>
          )}

          {product.category && (
            <span className="text-[11px] text-gray-400 uppercase tracking-wider block">
              <TranslatedText text={product.category.name_fr} arText={product.category.name_ar} />
            </span>
          )}

          <Link href={`/product/${product.slug}`}>
            <h4 className="font-semibold text-gray-800 mt-1 mb-2 hover:text-emerald-600 transition line-clamp-1">
              <TranslatedText text={product.name_fr} arText={product.name_ar} />
            </h4>
          </Link>
        </div>
      </div>

      {/* Bas de la carte */}
      <div className="p-4 pt-0 flex items-center justify-between border-t border-gray-50 mt-2">
        <div>
          <span className="text-lg font-bold text-gray-900 block">
            {finalPrice.toFixed(2)} MAD
          </span>
          {originalPrice && (
            <span className="text-xs text-gray-400 line-through">
              {originalPrice.toFixed(2)} MAD
            </span>
          )}
        </div>

        <button
          onClick={() =>
            addItem({
              id: product.id,
              name_fr: product.name_fr,
              name_ar: product.name_ar ?? "",
              price: finalPrice,
              image: imageUrl,
            })
          }
          className="w-10 h-10 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center transition-all duration-300 shadow-sm cursor-pointer"
          aria-label="Ajouter au panier"
        >
          <FiShoppingCart size={18} />
        </button>
      </div>
    </div>
  );
}