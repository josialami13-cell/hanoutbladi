datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================
// 1. ÉQUIPE INTERNE & GESTION DES ACCÈS (PERMISSIONS DYNAMIQUES)
// =============================================================

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String   // Mot de passe haché
  phone       String?  

  // Systemes de cases a cocher dynamiques (Ex: ["MANAGE_PRODUCTS", "MANAGE_ORDERS", "VIEW_MAP"])
  permissions String[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =============================================================
// 2. GESTION DES COMMERCIAUX (AGENTS COMMERCIAL)
// =============================================================
model Commercial {
  id             String   @id @default(cuid())
  matricule      String   @unique // Ex: "COM-2026-001"
  fullName       String
  phone          String   @unique
  email          String?  @unique
  commissionRate Float?   @default(0) // Taux de commission (%)
  isActive       Boolean  @default(true)
  notes          String?

  // Relations
  clients        Client[] // Portefeuille clients affectés
  orders         Order[]  // Commandes apportées par ce commercial

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("commercials")
}

// =============================================================
// 3. CATÉGORIES DE CLIENTS DYNAMIQUES & ACHETEURS
// =============================================================
enum ClientType {
  PARTICULIER  // زبون محلي
  SOCIETE      // شركة
  GROSSISTE    // زبون بالجملة
  REVENDEUR    // revendeur / épicerie
  EMPLOYE      // employé de société partenaire
}

// Table pour gérer dynamiquement les types de clients et leurs remises
model ClientCategory {
  id           String   @id @default(cuid())
  name         String   @unique // Ex: "Grossiste", "Revendeur", "Employé Société"
  code         String   @unique // Ex: "GROSSISTE", "REVENDEUR"
  description  String?
  discountRate Float    @default(0) // Remise par défaut en %

  clients      Client[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id                     String          @id @default(cuid())
  name                   String
  phone                  String          @unique
  email                  String?         @unique
  password               String?
  address                String?
  city                   String?
  
  // Champs pour la réinitialisation de mot de passe par WhatsApp
  resetToken             String?
  resetTokenExpiry       DateTime?

  // Typologie commerciale (Enum fixe + Catégorie dynamique optionnelle)
  clientType             ClientType      @default(PARTICULIER)
  categoryId             String?
  category               ClientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Affectation Commercial
  commercialId           String?
  commercial             Commercial?     @relation(fields: [commercialId], references: [id], onDelete: SetNull)

  // Options Logistique & Terrain (Dépôt et Livreur attitré)
  depositName            String?  // Nom du dépôt ou point de vente rattaché
  assignedDeliveryPerson String?  // Nom ou ID du livreur attitré à ce client

  latitude               Float?   // خط العرض GPS
  longitude              Float?   // خط الطول GPS
  loyaltyPoints          Int      @default(0)
  favoriteProducts       Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  orders                 Order[]
  reviews                ProductReview[]
}

// =============================================================
// 4. MULTI-SOCIÉTÉS & FACTURATION (FS PRO, PLAZA, ARAHMA...)
// =============================================================
model Company {
  id           String        @id @default(cuid())
  name         String        // Ex: "FS PRO", "Plaza d'Oliviers", "Arahma"
  ice          String?       // Identifiant Commun de l'Entreprise
  rc           String?       // Registre de Commerce
  taxId        String?       // Identifiant Fiscal (IF)
  patente      String?
  address      String?
  phone        String?
  email        String?
  logo         String?       // URL du logo pour l'impression PDF

  invoiceItems InvoiceItem[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("companies")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // Ex: "FA-2026-0001"
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  totalAmount   Float
  pdfUrl        String?       // Fichier PDF généré

  items         InvoiceItem[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  description String   // Libellé du produit facturé
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  @@map("invoice_items")
}

// =============================================================
// 5. CATALOGUE E-COMMERCE & BONUS PRODUITS
// =============================================================
model Department {
  id             String     @id @default(cuid())
  name_fr        String
  name_ar        String?
  slug           String     @unique
  description_fr String?
  description_ar String?
  categories     Category[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  isActive       Boolean    @default(true)
  isFeatured     Boolean    @default(false)
  image          String?
}

model Category {
  id             String     @id @default(cuid())
  name_fr        String
  name_ar        String?
  slug           String     @unique
  description_fr String?
  description_ar String?
  image          String?
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  isActive       Boolean    @default(true)
  isFeatured     Boolean    @default(false)
}

model Product {
  id                   String          @id @default(cuid())
  sku                  String?         @unique
  name_fr              String
  name_ar              String?
  slug                 String          @unique
  description_fr       String?         @db.Text
  description_ar       String?         @db.Text
  barcode              String?         @unique
  color                String?
  brand                String?
  images               String[]
  categoryId           String
  category             Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPickup             Boolean         @default(false)
  isPreorder           Boolean         @default(false)
  isCassable           Boolean         @default(false)
  isBoutique           Boolean         @default(false)
  isNonStock           Boolean         @default(false)
  isDateExpChecked     Boolean         @default(false)
  isActive             Boolean         @default(true)
  isFeatured           Boolean         @default(false)
  promotionalBadge     String?
  isTempControlled     Boolean         @default(false)
  minTemp              Float?
  maxTemp              Float?
  viewsCount           Int             @default(0)
  salesCount           Int             @default(0)
  rating               Float           @default(0.0)
  reviewsCount         Int             @default(0)
  preparationDays      Int             @default(0)
  expirationDate       DateTime?
  loyaltyPoints        Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  type1                String?
  type2                String?
  type3                String?
  type4                String?
  ch1                  Boolean         @default(false)
  ch2                  Boolean         @default(false)
  ch3                  Boolean         @default(false)
  ch4                  Boolean         @default(false)
  ch5                  Boolean         @default(false)
  unit                 String?
  weight               Float?
  dimensions           String?
  packagingType        String?
  minQuantity          Int             @default(1)
  maxQuantity          Int?
  stock                Int             @default(0)
  minStockAlert        Int             @default(5)
  price                Float
  lastPurchasePrice    Float?
  discount             Float           @default(0.00)
  tva                  Float           @default(0.00)
  shippingFee          Float           @default(0.00)
  totalPrice           Float?

  // --- Gestion du Bonus / Produit Offert ---
  hasBonus             Boolean         @default(false)
  minQuantityForBonus  Int?            @default(10)
  bonusQuantity        Int?            @default(1)
  
  bonusProductId       String?
  bonusProduct         Product?        @relation("ProductBonus", fields: [bonusProductId], references: [id], onDelete: SetNull)
  bonusForProducts     Product[]       @relation("ProductBonus")

  orderItems           OrderItem[]
  purchases            Purchase[]
  reviews              ProductReview[]
  bundleItems          BundleItem[]
}

// =============================================================
// 6. GESTION DES COMMANDES (CHECKOUT & WORKFLOW)
// =============================================================
enum OrderStatus {
  PENDING     // En attente / Nouvelle commande
  APPROVED    // Approuvée par l'admin
  DELIVERING  // En cours de livraison
  DELIVERED   // Livré validé
  PAID        // Encaissement validé
  ARCHIVED    // Archivé
  CANCELLED   // Annulé
}

enum PaymentStatus {
  PENDING
  PENDING_COLLECTION
  PAID
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  customerName      String
  customerPhone     String
  customerEmail     String?
  address           String
  city              String
  country           String        @default("Maroc")
  totalAmount       Float
  shippingFee       Float         @default(0.00)
  loyaltyPointsUsed Int           @default(0)
  loyaltyDiscount   Float         @default(0.00)
  bundleDiscount    Float         @default(0.00)
  shippingMode      String        @default("standard")
  status            OrderStatus   @default(PENDING)
  paymentMethod     String        @default("cash_on_delivery")
  paymentStatus     PaymentStatus @default(PENDING)
  notes             String?

  // Ajoute ces deux lignes ici :
  clientId  String   // (ou Int si l'id de ton client est un entier)
  client    Client   @relation(fields: [clientId], references: [id])

  // Commercial ayant conclu la vente
  commercialId      String?
  commercial        Commercial?   @relation(fields: [commercialId], references: [id], onDelete: SetNull)

  userId            String?

  items             OrderItem[]
  reviews           ProductReview[]
  delivery          Delivery?
  invoices          Invoice[]     // Liens vers les fiches de facturation multi-sociétés

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model ProductReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?  @db.Text
  status    String   @default("PENDING")
  productId String
  clientId  String
  orderId   String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([productId, status])
  @@index([clientId])
}

model ProductBundle {
  id              String       @id @default(cuid())
  name_fr         String
  name_ar         String?
  slug            String       @unique
  description_fr  String?      @db.Text
  image           String?
  discountPercent Float        @default(10)
  isActive        Boolean      @default(true)
  items           BundleItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model BundleItem {
  id        String        @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int           @default(1)
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([productId])
}

// =============================================================
// 7. LOGISTIQUE, FOURNISSEURS & ACHATS
// =============================================================
model Supplier {
  id            String     @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  city          String?
  speciality    String?
  purchases     Purchase[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model DeliveryMan {
  id         String     @id @default(cuid())
  fullName   String
  phone      String
  zone       String     @default("Settat et environs")
  vehicle    String     @default("Scooter")
  status     String     @default("Disponible")
  deliveries Delivery[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Delivery {
  id             String       @id @default(cuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryManId  String?
  deliveryMan    DeliveryMan? @relation(fields: [deliveryManId], references: [id], onDelete: SetNull)
  status         String       @default("En attente")
  trackingNumber String?      @unique
  shippingFee    Float        @default(0.00)
  notes          String?
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Purchase {
  id           String    @id @default(cuid())
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String
  productName  String
  quantity     String
  totalCost    Float
  status       String    @default("Livré")
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Setting {
  id                    String   @id @default("global_settings")
  storeName             String   @default("Plaza D'Oliviers")
  storeTagline          String   @default("Domaine oléicole, produits de terroir & épicerie fine")
  contactEmail          String   @default("contact@plazadoliviers.ma")
  contactPhone          String   @default("+212 6 00 00 00 00")
  address               String   @default("settat, Km 5")
  city                  String   @default("Settat")
  currency              String   @default("MAD")
  defaultMinStockAlert  Int      @default(5)
  logoUrl               String   @default("/images/logo.png")
  heroBannerUrl         String   @default("/images/hero-bg.jpg")
  aboutImageUrl         String   @default("/images/about-farm.jpg")
  openingHours          Json?
  enableHomeDelivery    Boolean  @default(true)
  enablePickup          Boolean  @default(true)
  standardShippingFee   Float    @default(30)
  expressShippingFee    Float    @default(50)
  paymentCashOnDelivery Boolean  @default(true)
  paymentBankTransfer   Boolean  @default(true)
  paymentCashPlus       Boolean  @default(true)
  paymentCreditCard     Boolean  @default(false)
  videoUrls             Json?
  updatedAt             DateTime @updatedAt
}

// =============================================================
// 8. SÉCURITÉ & RÉINITIALISATION DE MOT DE PASSE
// =============================================================
model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// =============================================================
// 9. BANNIÈRES & PUBLICITÉS ADMINISTRABLES (PLAZA & HANOUT)
// =============================================================
enum BannerType {
  PLAZA_ACTIVITY // أنشطة ضيعة بلازا ديس أوليفييه
  HANOUT_PRODUCT // عروض ومستجدات حانوت بلادي
}

model Banner {
  id          String     @id @default(cuid())
  title       String     // العنوان الرئيسي
  subtitle    String?    // العنوان الفرعي / الشعار
  description String?    @db.Text
  imageUrl    String     // رابط الصورة المرفوعة
  linkUrl     String?    @default("/shop") // رابط التوجيه عند النقر
  buttonText  String?    @default("Découvrir")
  type        BannerType @default(PLAZA_ACTIVITY)
  
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0) // ترتيب العرض

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("banners")
}