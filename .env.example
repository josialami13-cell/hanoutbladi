# =============================================================
# VARIABLES D'ENVIRONNEMENT - Hanout Bladi
# =============================================================
# Copiez ce fichier en ".env" et remplissez vos propres valeurs
# Commande : copy .env.example .env (sur Windows)
# =============================================================

# --- BASE DE DONNÉES ---
# Créez un compte gratuit sur https://neon.tech
# Puis copiez l'URL de connexion ici
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# --- AUTHENTIFICATION ADMIN ---
# Changez cette clé secrète par une chaîne aléatoire (tapez n'importe quoi de long)
NEXTAUTH_SECRET="changez-moi-par-une-chaine-aleatoire-tres-longue-12345"
NEXTAUTH_URL="http://localhost:3000"

# --- ADMIN PAR DÉFAUT ---
# L'email et mot de passe pour accéder au panneau admin
ADMIN_EMAIL="admin@hanoutbladi.ma"
ADMIN_PASSWORD="VotreMotDePasse123!"

# --- SITE ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Hanout Bladi"
NEXT_PUBLIC_WHATSAPP_NUMBER="212XXXXXXXXX"
